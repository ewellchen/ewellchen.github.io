#!/usr/bin/env ruby
# frozen_string_literal: true

#
# This file was generated by Bundler.
#
# The application 'jekyll' is installed as part of a gem, and
# this file is here to facilitate running it.
#

ENV["BUNDLE_GEMFILE"] ||= File.expand_path("../Gemfile", __dir__)

bundle_binstub = File.expand_path("bundle", __dir__)

if File.file?(bundle_binstub)
  if File.read(bundle_binstub, 300).include?("This file was generated by Bundler")
    load(bundle_binstub)
  else
    abort("Your `bin/bundle` was not generated by Bundler, so this binstub cannot run.
Replace `bin/bundle` by running `bundle binstubs bundler --force`, then run this command again.")
  end
end

require "rubygems"
require "bundler/setup"
require "liquid"

liquid_tags = File.join(Gem::Specification.find_by_name("liquid").full_gem_path, "lib", "liquid", "tags")
Dir.children(liquid_tags).grep(/\.rb\z/).sort.each do |file|
  require File.join(liquid_tags, file)
end

require "bibtex/filters"
bibtex_filters = File.join(Gem::Specification.find_by_name("bibtex-ruby").full_gem_path, "lib", "bibtex", "filters")
Dir.children(bibtex_filters).grep(/\.rb\z/).sort.each do |file|
  require File.join(bibtex_filters, file)
end

# Jekyll 4.4.1 can load some submodules in the wrong order on this Windows
# Ruby setup. Requiring them here keeps the local binstub reliable.
require "jekyll/filters/url_filters"
require "jekyll/filters/grouping_filters"
require "jekyll/filters/date_filters"
require "kramdown"
require "jekyll"

jekyll_lib = File.join(Gem::Specification.find_by_name("jekyll").full_gem_path, "lib")
%w[commands converters drops tags].each do |directory|
  absolute_directory = File.join(jekyll_lib, "jekyll", directory)
  Dir.children(absolute_directory).grep(/\.rb\z/).sort.each do |file|
    require File.join(absolute_directory, file)
  end
end
require "jekyll/converters/markdown/kramdown_parser"

load Gem.bin_path("jekyll", "jekyll")
